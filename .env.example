# ════════════════════════════════════════════════════════════════
# Шаблон .env для проекта Иван Гуничев — Инструктор по вождению
# Скопируйте в .env и заполните значения
# ════════════════════════════════════════════════════════════════

# Секретный ключ Django — сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Режим отладки: True — разработка, False — продакшн
DEBUG=False

# Разрешённые хосты (через запятую, без пробелов)
ALLOWED_HOSTS=ivan-gunichev.ru,www.ivan-gunichev.ru

# ── PostgreSQL ────────────────────────────────────────────────────
DB_NAME=driving_instructor
DB_USER=drivinguser
DB_PASSWORD=your-db-password-here
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Email (SMTP Яндекс) ──────────────────────────────────────────
# Пароль приложения: mail.yandex.ru → Настройки → Безопасность → Пароли приложений
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=gialekseevich@yandex.ru
EMAIL_HOST_PASSWORD=ВАШ_ПАРОЛЬ_ПРИЛОЖЕНИЯ
OWNER_EMAIL=gialekseevich@yandex.ru

# ── PHP mail-обработчик (резерв если SMTP не настроен) ───────────
# Токен должен совпадать с $SECRET_TOKEN в send-email.php на сервере
MAIL_PHP_URL=https://ivan-gunichev.ru/send-email.php
MAIL_PHP_TOKEN=GunichevMail2026xK9p

# ── Telegram Bot (опционально) ────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# ── Продакшн: доверенные origins для CSRF ────────────────────────
CSRF_TRUSTED_ORIGINS=https://ivan-gunichev.ru,https://www.ivan-gunichev.ru
